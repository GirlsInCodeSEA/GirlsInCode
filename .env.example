# Copy to .env and fill in. Never commit .env.
# Supabase dashboard → Project Settings → API (or "API Keys"):
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key (or the newer sb_secret_... key), not the anon/publishable key.
SUPABASE_SERVICE_KEY=
SECRET_KEY=
# Emails (comma-separated) that can open /admin/submissions to see every submission and its code.
ADMIN_EMAILS=
# Optional: rehearse the competition locally by moving the window, e.g.
# COMPETITION_START=2026-11-23T15:00:00+08:00
# COMPETITION_END=2026-11-23T18:00:00+08:00
